{
  "name": "ts-only",
  "version": "1.0.0",
  "description": "Keep a repository TypeScript-only: a CLI and GitHub Action that fail when JavaScript files appear.",
  "keywords": [
    "typescript",
    "javascript",
    "github-action",
    "ci"
  ],
  "homepage": "https://github.com/MarcLlobet/ts-only#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcLlobet/ts-only.git"
  },
  "license": "MIT",
  "author": "Marc Llobet",
  "type": "module",
  "bin": {
    "ts-only": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "node --test \"src/*.test.ts\" \"scripts/*.test.ts\"",
    "lint": "eslint --config ./eslint.config.ts",
    "tscheck": "tsc --noEmit",
    "ts-only": "node src/cli.ts",
    "prepare": "husky || true"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.5.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.32.1"
  },
  "dependencies": {}
}
